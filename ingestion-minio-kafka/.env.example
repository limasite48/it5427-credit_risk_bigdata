# Copy to .env (read automatically by docker compose) or export these before running the scripts.
# The values below are for local/demo use only.

# --- docker compose ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
SVC_INGEST_SECRET=ingest-secret-123
SVC_SPARK_SECRET=spark-secret-123
SVC_ML_SECRET=ml-secret-123
SVC_DASHBOARD_SECRET=dashboard-secret-123

# --- ingestion scripts ---
KAFKA_BOOTSTRAP=localhost:9092
LAKE_MODE=minio              # local = write to the lake/ folder ; minio = write to MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=svc-ingest
MINIO_SECRET_KEY=ingest-secret-123
HC_LIVE_START=2025-12-01     # batch before this date, stream from this date on
HC_RAW_DIR=../_data          # path to raw Kaggle CSVs (auto-detected if omitted)
