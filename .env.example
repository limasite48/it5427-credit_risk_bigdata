# Copy to .env and adjust. Never commit .env.

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=8088
ML_SERVICE_PORT=8000
VITE_DEV_PORT=5173

# Internal ML service (not publicly exposed in Docker)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=change-me-ml-internal-token-32chars
ML_MAX_BODY_BYTES=262144

# JWT / auth
JWT_SECRET=change-me-jwt-secret-must-be-32-chars-min
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
SCORE_RATE_LIMIT=30

# CORS allowlist (comma-separated, no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://127.0.0.1:5173,http://127.0.0.1:8088

# Data paths (local development relative to backend working directory)
DATA_DIR=../outputs
MODEL_PATH=../outputs/models/credit_risk_model.joblib
SCORED_CSV=../outputs/scored_applications_sample.csv
GOLD_SCORED_CSV=../outputs/gold_scored_applications.csv
RISK_SUMMARY=../outputs/metrics/risk_summary.json
DEMOGRAPHICS=../outputs/metrics/demographic_profiles.json
ROC_CURVE=../outputs/figures/roc_curve.png
SHAP_SUMMARY=../outputs/figures/shap_summary.png
MODEL_EVALUATION=../outputs/metrics/model_evaluation.json
SUPPLEMENTARY_DIR=../ingestion-minio-kafka/data/supplementary
SPARK_REPORTS_DIR=../apache-spark/reports

# Demo users (local/demo only — replace before any shared deployment)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=AdminDemo!234
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=AnalystDemo!234
DEMO_UNDERWRITER_USERNAME=underwriter
DEMO_UNDERWRITER_PASSWORD=UnderwriterDemo!234

# Logging
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=local
